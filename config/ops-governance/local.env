BATCH_INFRA_GOVERNANCE_PROFILE=local

POSTGRES_MAX_WAL_SIZE=1GB
POSTGRES_CHECKPOINT_TIMEOUT=5min
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_SYNCHRONOUS_COMMIT=on
POSTGRES_WAL_COMPRESSION=off
POSTGRES_AUTOVACUUM_VACUUM_SCALE_FACTOR=0.1
POSTGRES_AUTOVACUUM_ANALYZE_SCALE_FACTOR=0.1
POSTGRES_AUTOVACUUM_VACUUM_INSERT_SCALE_FACTOR=0.2
POSTGRES_AUTOVACUUM_NAPTIME=1min
POSTGRES_AUTOVACUUM_MAX_WORKERS=3

KAFKA_LOG_RETENTION_HOURS=6
KAFKA_LOG_RETENTION_BYTES=1073741824
KAFKA_LOG_SEGMENT_BYTES=67108864
KAFKA_TOPIC_RETENTION_MS=21600000
KAFKA_TOPIC_RETENTION_MS_RETRY=86400000
KAFKA_TOPIC_RETENTION_MS_DEAD_LETTER=604800000
KAFKA_TOPIC_CLEANUP_POLICY=delete

VALKEY_MAXMEMORY=384mb
VALKEY_MAXMEMORY_POLICY=noeviction
VALKEY_APPENDONLY=yes
VALKEY_APPENDFSYNC=everysec

MINIO_LIFECYCLE_ENVIRONMENT=local
MINIO_LIFECYCLE_APPLY_ON_INIT=true

BATCH_STORAGE_BACKEND=s3
BATCH_STORAGE_FILESYSTEM_ROOT=/tmp/batch/object-store
BATCH_DISPATCH_LOCAL_SANDBOX_ROOT=/tmp/batch/local-dispatch
BATCH_DISPATCH_NAS_SANDBOX_ROOT=/tmp/batch/nas-probe
BATCH_DISPATCH_NAS_COPY_TIMEOUT_SECONDS=300
BATCH_DISPATCH_OSS_MAX_INLINE_MIB=256
BATCH_DISPATCH_PROBE_CONNECT_TIMEOUT_MS=3000
BATCH_DISPATCH_PROBE_READ_TIMEOUT_MS=5000
BATCH_DISPATCH_CHANNEL_TYPES_GOVERNED=LOCAL,NAS,SFTP,OSS,API,API_PUSH,EMAIL
BATCH_DISPATCH_SFTP_STRICT_HOST_KEY_REQUIRED=false
BATCH_DISPATCH_API_EGRESS_ALLOWLIST_REQUIRED=false
BATCH_DISPATCH_EMAIL_TLS_REQUIRED=false

BATCH_WORKER_REPORT_OUTBOX_ENABLED=false
BATCH_WORKER_REPORT_OUTBOX_STORAGE=PLATFORM_PG
BATCH_WORKER_REPORT_OUTBOX_SQLITE_PATH=/tmp/batch/worker-report-outbox.db
BATCH_WORKER_REPORT_OUTBOX_POLL_INTERVAL_MS=5000
BATCH_WORKER_REPORT_OUTBOX_POLL_BATCH_SIZE=8
BATCH_WORKER_REPORT_OUTBOX_PUBLISHING_STALE_MS=120000

BATCH_QUOTA_RUNTIME_STORE=redis
BATCH_QUOTA_REDIS_FAILURE_MODE=FAIL_CLOSED
BATCH_SHEDLOCK_PROVIDER=redis
BATCH_SHEDLOCK_REDIS_ENV=local
BATCH_CONSOLE_READ_REPLICA_ENABLED=true
BATCH_DATASOURCE_BUSINESS_ROUTING_ENABLED=false
BATCH_TRIGGER_MISFIRE_PENDING_RETENTION_DAYS=7
BATCH_TRIGGER_QUARTZ_DB_MAX_POOL_SIZE=5
BATCH_TRIGGER_OUTBOX_MAX_PUBLISH_ATTEMPTS=10

BATCH_OBSERVABILITY_RETENTION_DAYS=3
BATCH_OBSERVABILITY_LOG_RETENTION_DAYS=3
OTEL_SAMPLING_PROBABILITY=1.0
BATCH_OPENLINEAGE_ENABLED=false
BATCH_EXTERNAL_ENDPOINT_EGRESS_ALLOWLIST_REQUIRED=false
