#!/usr/bin/env bash
# 启用：git config core.hooksPath .githooks（每人 clone 后跑一次）
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

# 禁止绕过 PR 直接推送受保护主分支。stdin 每行格式由 Git 定义：
# <local-ref> <local-sha> <remote-ref> <remote-sha>。
reject_direct_push=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "拒绝直接推送受保护分支 ${remote_ref}；请通过特性分支和 PR 交付。" >&2
      reject_direct_push=1
      ;;
  esac
done

if bash "$ROOT/scripts/local/pre-push-sdk-checks.sh"; then
  validation_status=0
else
  validation_status=$?
fi

if ((reject_direct_push == 1 || validation_status != 0)); then
  exit 1
fi
