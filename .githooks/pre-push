#!/usr/bin/env bash
# 用途：在推送前执行本仓库的分域构建与质量检查。
# 用法：先执行 git config core.hooksPath .githooks，由 Git 的 pre-push 阶段调用。
# 启用：git config core.hooksPath .githooks（每人 clone 后跑一次）
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

# 禁止绕过 PR 直接推送受保护主分支。stdin 每行格式由 Git 定义：
# <local-ref> <local-sha> <remote-ref> <remote-sha>。
reject_direct_push=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      printf '❌ 不通过 | code=PRE_PUSH_PROTECTED_BRANCH | gate=受保护分支推送 | group=governance | mode=enforce | exit_code=1 | action=fix_and_retry | reason=拒绝直接推送 %s，请通过特性分支和 PR 交付\n' "$remote_ref" >&2
      reject_direct_push=1
      ;;
  esac
done

if bash "$ROOT/scripts/ci/run-gate.sh" --group local-pre-push PRE_PUSH_CHECKS "推送前静态预检" -- \
  bash "$ROOT/scripts/local/pre-push-sdk-checks.sh"; then
  validation_status=0
else
  validation_status=$?
fi

if ((reject_direct_push == 1 || validation_status != 0)); then
  exit 1
fi
