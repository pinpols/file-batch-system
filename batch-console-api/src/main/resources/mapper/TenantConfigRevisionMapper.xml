<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.pinpols.batch.console.mapper.TenantConfigRevisionMapper">
    <select id="currentConfigurationRevision" resultType="java.lang.Long">
        select batch.current_tenant_configuration_revision(#{tenantId})
    </select>

    <select id="lockConfigurationRevision" resultType="java.lang.Long">
        select batch.lock_tenant_configuration_revision(#{tenantId})
    </select>
</mapper>
