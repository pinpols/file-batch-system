<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.pinpols.batch.console.mapper.AuditLogMapper">
    <resultMap id="FileAuditLogRowMap"
               type="io.github.pinpols.batch.console.domain.audit.view.FileAuditLogRow">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="tenant_id" javaType="java.lang.String"/>
            <arg column="file_id" javaType="java.lang.Long"/>
            <arg column="operation_type" javaType="java.lang.String"/>
            <arg column="operation_result" javaType="java.lang.String"/>
            <arg column="operator_type" javaType="java.lang.String"/>
            <arg column="operator_id" javaType="java.lang.String"/>
            <arg column="trace_id" javaType="java.lang.String"/>
            <arg column="evidence_ref" javaType="java.lang.String"/>
            <arg column="detail_summary" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <select id="selectByQuery" resultMap="FileAuditLogRowMap">
        select
            id,
            tenant_id,
            file_id,
            operation_type,
            operation_result,
            operator_type,
            operator_id,
            trace_id,
            evidence_ref,
            detail_summary,
            created_at
        from batch.file_audit_log
        where tenant_id = #{tenantId}
        <if test="cursorId != null">
            and id &lt; #{cursorId}
        </if>
        <if test="operationType != null and operationType != ''">
            and operation_type = #{operationType}
        </if>
        <if test="operationResult != null and operationResult != ''">
            and operation_result = #{operationResult}
        </if>
        <if test="operatorId != null and operatorId != ''">
            and operator_id like concat('%', #{operatorId}, '%')
        </if>
        <if test="fileId != null">
            and file_id = #{fileId}
        </if>
        <if test="traceId != null and traceId != ''">
            and trace_id = #{traceId}
        </if>
        <if test="fromTime != null">
            and created_at &gt;= #{fromTime}
        </if>
        <if test="toTime != null">
            and created_at &lt;= #{toTime}
        </if>
        order by id desc
        <choose>
            <when test="cursorId != null">
                limit #{pageRequest.pageSize}
            </when>
            <otherwise>
                <include refid="io.github.pinpols.batch.common.mapper.CommonFragments.offsetPageClause"/>
            </otherwise>
        </choose>
    </select>

    <select id="countByQuery" resultType="long">
        select count(1)
        from batch.file_audit_log
        where tenant_id = #{tenantId}
        <if test="operationType != null and operationType != ''">
            and operation_type = #{operationType}
        </if>
        <if test="operationResult != null and operationResult != ''">
            and operation_result = #{operationResult}
        </if>
        <if test="operatorId != null and operatorId != ''">
            and operator_id like concat('%', #{operatorId}, '%')
        </if>
        <if test="fileId != null">
            and file_id = #{fileId}
        </if>
        <if test="traceId != null and traceId != ''">
            and trace_id = #{traceId}
        </if>
        <if test="fromTime != null">
            and created_at &gt;= #{fromTime}
        </if>
        <if test="toTime != null">
            and created_at &lt;= #{toTime}
        </if>
    </select>
</mapper>
