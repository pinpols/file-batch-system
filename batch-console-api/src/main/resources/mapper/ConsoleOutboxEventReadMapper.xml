<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.pinpols.batch.console.domain.ops.mapper.ConsoleOutboxEventReadMapper">

    <select id="countByStatus" resultType="long">
        select count(*)
        from batch.outbox_event
        where tenant_id = #{tenantId}
          and publish_status = #{publishStatus}
    </select>

    <resultMap id="OutboxEventStatusStatMap"
               type="io.github.pinpols.batch.console.domain.ops.view.OutboxEventStatusStat">
        <constructor>
            <arg column="publish_status" javaType="java.lang.String"/>
            <arg column="status_count" javaType="long"/>
            <arg column="oldest" javaType="java.time.Instant"/>
            <arg column="newest" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <select id="statsByStatus" resultMap="OutboxEventStatusStatMap">
        select publish_status,
               count(*)        as status_count,
               min(created_at) as oldest,
               max(created_at) as newest
        from batch.outbox_event
        where tenant_id = #{tenantId}
        group by publish_status
        order by publish_status
    </select>

    <!-- 故意只保留 SELECT — docs/agent-baseline.md「Orchestrator 是唯一状态主机」硬约束下，console 不直接写
         outbox_event；cleanup / republish 由 orchestrator /internal/outbox/* 接口承接。 -->

</mapper>
