<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.pinpols.batch.console.domain.ops.mapper.OutboxRetryLogMapper">
    <resultMap id="outboxRetryLogRowMap"
               type="io.github.pinpols.batch.console.domain.ops.view.OutboxRetryLogRow">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="outbox_event_id" javaType="java.lang.Long"/>
            <arg column="tenant_id" javaType="java.lang.String"/>
            <arg column="event_type" javaType="java.lang.String"/>
            <arg column="event_key" javaType="java.lang.String"/>
            <arg column="retry_status" javaType="java.lang.String"/>
            <arg column="retry_count" javaType="java.lang.Integer"/>
            <arg column="retry_policy" javaType="java.lang.String"/>
            <arg column="next_retry_at" javaType="java.time.Instant"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <sql id="retryParentJoin">
        join batch.outbox_event e
          on e.tenant_id = r.tenant_id
         and e.id = r.outbox_event_id
         and e.created_at = r.outbox_event_created_at
    </sql>

    <sql id="retryFilters">
        where 1 = 1
        <if test="tenantId != null and tenantId != ''">
            and r.tenant_id = #{tenantId}
        </if>
        <if test="retryStatus != null and retryStatus != ''">
            and r.retry_status = #{retryStatus}
        </if>
        <if test="eventKey != null and eventKey != ''">
            and r.event_key = #{eventKey}
        </if>
        <if test="eventType != null and eventType != ''">
            and e.event_type = #{eventType}
        </if>
    </sql>

    <select id="selectByQuery" resultMap="outboxRetryLogRowMap">
        select r.id,
               r.outbox_event_id,
               r.tenant_id,
               e.event_type,
               r.event_key,
               r.retry_status,
               r.retry_attempt as retry_count,
               null as retry_policy,
               r.next_retry_at,
               r.created_at,
               r.updated_at
        from batch.event_outbox_retry r
        <include refid="retryParentJoin"/>
        <include refid="retryFilters"/>
        <if test="cursorId != null">
            and r.id &lt; #{cursorId}
        </if>
        order by r.id desc
        <if test="pageRequest != null">
            limit #{pageRequest.pageSize}
            <if test="cursorId == null">
                offset (#{pageRequest.pageNo} - 1) * #{pageRequest.pageSize}
            </if>
        </if>
    </select>

    <select id="countByQuery" resultType="long">
        select count(1)
        from batch.event_outbox_retry r
        <if test="eventType != null and eventType != ''">
            <include refid="retryParentJoin"/>
        </if>
        <include refid="retryFilters"/>
    </select>

    <select id="countByStatuses" resultType="long">
        select count(1)
        from batch.event_outbox_retry
        where tenant_id = #{tenantId}
          and retry_status in
        <foreach collection="statuses" item="status" open="(" close=")" separator=",">
            #{status}
        </foreach>
    </select>
</mapper>
