<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.pinpols.batch.console.domain.ops.mapper.JobTaskMapper">
    <resultMap id="JobTaskHeartbeatResultMap" type="io.github.pinpols.batch.console.domain.ops.view.JobTaskHeartbeatView">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="task_status" property="taskStatus"/>
        <result column="heartbeat_details" property="heartbeatDetails"/>
        <result column="heartbeat_at" property="heartbeatAt"/>
        <result column="cancel_requested" property="cancelRequested"/>
    </resultMap>

    <!-- ORCH-P4-1：heartbeat_details JSONB 以 ::text 读出,service 再解析为 JSON 透传 FE。
         租户维度强制(tenant_id 无条件入 WHERE),跨租户读不到。 -->
    <select id="selectHeartbeatByTenantAndId" resultMap="JobTaskHeartbeatResultMap">
        select id, tenant_id, task_status,
               heartbeat_details::text as heartbeat_details,
               heartbeat_at, cancel_requested
        from batch.job_task
        where id = #{taskId}
          and tenant_id = #{tenantId}
    </select>

    <resultMap id="JobTaskExecutionAuditResultMap" type="io.github.pinpols.batch.console.domain.ops.view.JobTaskExecutionAuditView">
        <id column="id" property="id"/>
        <result column="job_instance_id" property="jobInstanceId"/>
        <result column="job_code" property="jobCode"/>
        <result column="task_status" property="taskStatus"/>
        <result column="assigned_worker_code" property="assignedWorkerCode"/>
        <result column="effective_parameters" property="effectiveParameters"/>
        <result column="result_summary" property="resultSummary"/>
        <result column="error_code" property="errorCode"/>
        <result column="error_message" property="errorMessage"/>
        <result column="started_at" property="startedAt"/>
        <result column="finished_at" property="finishedAt"/>
    </resultMap>

    <!-- BIZ-20261113-02：执行审计。JSONB 以 ::text 读出，service 解析并脱敏。租户维度强制。 -->
    <select id="selectExecutionAuditByTenantAndId" resultMap="JobTaskExecutionAuditResultMap">
        select t.id, t.job_instance_id, ji.job_code, t.task_status, t.assigned_worker_code,
               t.effective_parameters::text as effective_parameters,
               t.result_summary::text as result_summary,
               t.error_code, t.error_message, t.started_at, t.finished_at
        from batch.job_task t
        join batch.job_instance ji
          on ji.id = t.job_instance_id
         and ji.tenant_id = t.tenant_id
        where t.id = #{taskId}
          and t.tenant_id = #{tenantId}
    </select>
</mapper>
