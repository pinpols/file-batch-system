<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.pinpols.batch.console.domain.ops.mapper.OutboxDeliveryLogMapper">
    <resultMap id="OutboxDeliveryLogRowMap"
               type="io.github.pinpols.batch.console.domain.ops.view.OutboxDeliveryLogRow">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="tenant_id" javaType="java.lang.String"/>
            <arg column="event_type" javaType="java.lang.String"/>
            <arg column="event_key" javaType="java.lang.String"/>
            <arg column="trace_id" javaType="java.lang.String"/>
            <arg column="delivery_status" javaType="java.lang.String"/>
            <arg column="target_topic" javaType="java.lang.String"/>
            <arg column="delivery_attempt" javaType="java.lang.Integer"/>
            <arg column="error_key" javaType="java.lang.String"/>
            <arg column="error_args" javaType="java.lang.String"/>
            <arg column="error_message" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <select id="selectByQuery" resultMap="OutboxDeliveryLogRowMap">
        select id,
               tenant_id,
               event_type,
               event_key,
               trace_id,
               delivery_status,
               target_topic,
               delivery_attempt,
               error_key,
               error_args,
               error_message,
               created_at,
               updated_at
        from batch.event_delivery_log
        where tenant_id = #{tenantId}
        <if test="deliveryStatus != null and deliveryStatus != ''">
            and delivery_status = #{deliveryStatus}
        </if>
        <if test="eventType != null and eventType != ''">
            and event_type = #{eventType}
        </if>
        <if test="eventKey != null and eventKey != ''">
            and event_key = #{eventKey}
        </if>
        <if test="targetTopic != null and targetTopic != ''">
            and strpos(lower(target_topic), lower(#{targetTopic})) &gt; 0
        </if>
        <if test="traceId != null and traceId != ''">
            and trace_id = #{traceId}
        </if>
        <if test="cursorId != null">
            and id &lt; #{cursorId}
        </if>
        order by id desc
        <if test="pageRequest != null">
            limit #{pageRequest.pageSize}
            <if test="cursorId == null">
                offset (#{pageRequest.pageNo} - 1) * #{pageRequest.pageSize}
            </if>
        </if>
    </select>

    <select id="countByQuery" resultType="long">
        select count(1)
        from batch.event_delivery_log
        where tenant_id = #{tenantId}
        <if test="deliveryStatus != null and deliveryStatus != ''">
            and delivery_status = #{deliveryStatus}
        </if>
        <if test="eventType != null and eventType != ''">
            and event_type = #{eventType}
        </if>
        <if test="eventKey != null and eventKey != ''">
            and event_key = #{eventKey}
        </if>
        <if test="targetTopic != null and targetTopic != ''">
            and strpos(lower(target_topic), lower(#{targetTopic})) &gt; 0
        </if>
        <if test="traceId != null and traceId != ''">
            and trace_id = #{traceId}
        </if>
    </select>

    <select id="countByStatus" resultType="long">
        select count(1)
        from batch.event_delivery_log
        where tenant_id = #{tenantId}
          and delivery_status = #{deliveryStatus}
    </select>
</mapper>
