<?xml version="1.0"?>
<ruleset name="batch-platform"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        batch-platform PMD 规约 — 对齐 docs/agent-baseline.md 编码规范
    </description>

    <!-- ============================================================
         docs/agent-baseline.md: 禁止在代码中使用全限定类名（FQN）
         已 import 的类型不得再用完整包路径引用。
         ============================================================ -->
    <rule ref="category/java/codestyle.xml/UnnecessaryFullyQualifiedName"/>

    <!-- ============================================================
         docs/agent-baseline.md: 方法参数数量不能超过 6 个
         PMD 对 minimum 使用严格大于比较，设为 6 才能拦截参数 ≥ 7 的方法。
         构造器（record / DTO / Spring DI）按既有规约豁免；
         XPath 只匹配当前报告节点所属构造器，不影响同文件的普通方法。
         ============================================================ -->
    <rule ref="category/java/design.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="6"/>
            <property name="violationSuppressXPath" value="./ancestor-or-self::ConstructorDeclaration"/>
        </properties>
    </rule>

    <!-- Mapper 的 5/6 参数与 Service 公共接口的 6 参数边界比一般方法更严格。 -->
    <rule name="MapperParameterCount" language="java"
          message="Mapper 公共方法达到 5 个参数，必须使用具名参数对象。"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>落实 coding-conventions §1 的 Mapper 公共方法参数边界。</description>
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
                    //MethodDeclaration[@Visibility = 'public']
                      [ancestor::ClassDeclaration[1][ends-with(@SimpleName, 'Mapper')]]
                      [count(FormalParameters/FormalParameter) >= 5
                       and count(FormalParameters/FormalParameter) < 7]
                ]]></value>
            </property>
        </properties>
    </rule>
    <rule name="ServicePublicParameterCount" language="java"
          message="Service 公共接口达到 6 个参数，必须使用具名参数对象。"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>落实 coding-conventions §1 的 Service 公共接口参数边界。</description>
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
                    //MethodDeclaration[@Visibility = 'public']
                      [ancestor::ClassDeclaration[1][ends-with(@SimpleName, 'Service')]]
                      [count(FormalParameters/FormalParameter) = 6]
                ]]></value>
            </property>
        </properties>
    </rule>

    <!-- ============================================================
         docs/agent-baseline.md: 分支消除 — inline else 体 > 10 行须提取为命名方法
         ExcessiveMethodLength 作为代理信号：方法体过长通常意味着
         未消除的分支内联，阈值设置宽松，仅捕获明显超标情形。
         ============================================================ -->
    <rule ref="category/java/design.xml/NcssCount">
        <properties>
            <property name="methodReportLevel" value="60"/>
            <property name="classReportLevel" value="1500"/>
            <property name="ncssOptions" value=""/>
        </properties>
    </rule>

    <!-- ============================================================
         质量基线
         ============================================================ -->

    <!-- 空 catch 块：注释说明理由时豁免 -->
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock">
        <properties>
            <property name="allowCommentedBlocks" value="true"/>
        </properties>
    </rule>

    <!-- 重复字符串字面量：≥ 7 次提取为常量（2026-04-26 从 5 次放宽到 7 次：4-6 次的局部重复属于
         可读性可接受，强制提常量反而引入间接层）；注解内豁免；exceptionList 忽略语义弱的常用字面量
         （提常量反而降低可读性，例如 SMTP Properties.put("...", "true")）。 -->
    <rule ref="category/java/errorprone.xml/AvoidDuplicateLiterals">
        <properties>
            <property name="maxDuplicateLiterals" value="7"/>
            <property name="skipAnnotations" value="true"/>
            <property name="exceptionList" value="true,false,null,UTF-8,utf-8"/>
        </properties>
    </rule>

</ruleset>
