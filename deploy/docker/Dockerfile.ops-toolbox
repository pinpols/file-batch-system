# syntax=docker/dockerfile:1.7
ARG PYTHON_VERSION=3.12
ARG MINIO_MC_IMAGE_REPOSITORY=bitnamilegacy/minio
ARG MINIO_MC_IMAGE_TAG=2025.7.23-debian-12-r1
ARG KAFKA_IMAGE_TAG=4.1.2

FROM ${MINIO_MC_IMAGE_REPOSITORY}:${MINIO_MC_IMAGE_TAG}@sha256:ba958aa5e12c8b1426dd95de61d8f1ed14741efa0ec730019ed57086930a4299 AS minio-client
FROM apache/kafka:${KAFKA_IMAGE_TAG}@sha256:5cc2a2fd93fa2687b44015eee04fb2c3edd9e526bd64bf8bec5ff1e268772e0e AS kafka-client

FROM python:${PYTHON_VERSION}-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258

ARG POSTGRES_CLIENT_MAJOR=17

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# 系统工具和 PostgreSQL 客户端不锁死 Debian 包补丁版本：基础镜像与 PGDG 源已固定大版本，
# 构建时应获取对应仓库的最新安全修复；精确 pin 会在仓库补丁滚动后使镜像不可构建。
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      curl \
      gnupg \
      gzip \
      jq \
      less \
      openjdk-17-jre-headless \
      procps \
      redis-tools \
      tar \
    && install -d -m 0755 /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      | gpg --dearmor -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends "postgresql-client-${POSTGRES_CLIENT_MAJOR}" \
    && groupadd --system --gid 10001 batch \
    && useradd --system --uid 10001 --gid batch --create-home --home-dir /home/batch batch \
    && rm -rf /var/lib/apt/lists/*

COPY --from=minio-client /opt/bitnami/minio-client/bin/mc /usr/local/bin/mc
COPY --from=kafka-client /opt/kafka/bin /opt/kafka-client/bin
COPY --from=kafka-client /opt/kafka/config /opt/kafka-client/config
COPY --from=kafka-client /opt/kafka/libs /opt/kafka-client/libs
COPY --from=kafka-client /opt/kafka/licenses /opt/kafka-client/licenses

RUN test -s /opt/kafka-client/libs/kafka-clients-*.jar \
    && for script in /opt/kafka-client/bin/kafka-*.sh; do \
      name="$(basename "$script")"; \
      printf '#!/usr/bin/env bash\nexec /opt/kafka-client/bin/%s "$@"\n' "$name" > "/usr/local/bin/$name"; \
      chmod 0755 "/usr/local/bin/$name"; \
    done \
    && /usr/local/bin/kafka-topics.sh --version >/dev/null

ENV KAFKA_BIN_DIR=/opt/kafka-client/bin \
    KAFKA_CONTAINER_BIN_DIR=/opt/kafka-client/bin \
    HOME=/home/batch \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH=/opt/kafka-client/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /workspace
USER batch:batch
CMD ["bash"]
