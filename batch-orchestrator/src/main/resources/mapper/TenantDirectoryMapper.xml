<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.pinpols.batch.orchestrator.mapper.TenantDirectoryMapper">
    <select id="selectRunnableTenantIds" resultType="string">
        select tenant_id
        from batch.tenant
        where status != 'SUSPENDED'
        order by tenant_id
    </select>
</mapper>
