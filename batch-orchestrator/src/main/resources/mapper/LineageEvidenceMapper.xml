<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.pinpols.batch.orchestrator.mapper.LineageEvidenceMapper">

    <resultMap id="JobInstanceResultMap" type="io.github.pinpols.batch.orchestrator.application.contract.response.LineageEvidenceResponse$JobInstance">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="tenant_id" javaType="java.lang.String"/>
            <arg column="job_code" javaType="java.lang.String"/>
            <arg column="biz_date" javaType="java.time.LocalDate"/>
            <arg column="instance_status" javaType="java.lang.String"/>
            <arg column="run_attempt" javaType="java.lang.Integer"/>
            <arg column="trace_id" javaType="java.lang.String"/>
            <arg column="related_file_id" javaType="java.lang.Long"/>
            <arg column="parent_instance_id" javaType="java.lang.Long"/>
            <arg column="replay_session_id" javaType="java.lang.Long"/>
            <arg column="started_at" javaType="java.time.Instant"/>
            <arg column="finished_at" javaType="java.time.Instant"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <resultMap id="PipelineInstanceResultMap" type="io.github.pinpols.batch.orchestrator.application.contract.response.LineageEvidenceResponse$PipelineInstance">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="tenant_id" javaType="java.lang.String"/>
            <arg column="pipeline_definition_id" javaType="java.lang.Long"/>
            <arg column="job_code" javaType="java.lang.String"/>
            <arg column="pipeline_type" javaType="java.lang.String"/>
            <arg column="file_id" javaType="java.lang.Long"/>
            <arg column="related_job_instance_id" javaType="java.lang.Long"/>
            <arg column="current_stage" javaType="java.lang.String"/>
            <arg column="last_success_stage" javaType="java.lang.String"/>
            <arg column="run_status" javaType="java.lang.String"/>
            <arg column="trace_id" javaType="java.lang.String"/>
            <arg column="started_at" javaType="java.time.Instant"/>
            <arg column="finished_at" javaType="java.time.Instant"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <resultMap id="FileRecordResultMap" type="io.github.pinpols.batch.orchestrator.application.contract.response.LineageEvidenceResponse$FileRecord">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="tenant_id" javaType="java.lang.String"/>
            <arg column="file_code" javaType="java.lang.String"/>
            <arg column="biz_type" javaType="java.lang.String"/>
            <arg column="file_category" javaType="java.lang.String"/>
            <arg column="file_name" javaType="java.lang.String"/>
            <arg column="file_format_type" javaType="java.lang.String"/>
            <arg column="file_size_bytes" javaType="java.lang.Long"/>
            <arg column="checksum_type" javaType="java.lang.String"/>
            <arg column="checksum_value" javaType="java.lang.String"/>
            <arg column="storage_type" javaType="java.lang.String"/>
            <arg column="storage_bucket" javaType="java.lang.String"/>
            <arg column="storage_path" javaType="java.lang.String"/>
            <arg column="file_status" javaType="java.lang.String"/>
            <arg column="biz_date" javaType="java.time.LocalDate"/>
            <arg column="trace_id" javaType="java.lang.String"/>
            <arg column="metadata_json" javaType="java.util.Map" typeHandler="io.github.pinpols.batch.orchestrator.infrastructure.mybatis.MapJsonbTypeHandler"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <resultMap id="DispatchRecordResultMap" type="io.github.pinpols.batch.orchestrator.application.contract.response.LineageEvidenceResponse$DispatchRecord">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="tenant_id" javaType="java.lang.String"/>
            <arg column="file_id" javaType="java.lang.Long"/>
            <arg column="pipeline_instance_id" javaType="java.lang.Long"/>
            <arg column="channel_code" javaType="java.lang.String"/>
            <arg column="dispatch_target" javaType="java.lang.String"/>
            <arg column="dispatch_status" javaType="java.lang.String"/>
            <arg column="dispatch_attempt" javaType="java.lang.Integer"/>
            <arg column="receipt_code" javaType="java.lang.String"/>
            <arg column="receipt_status" javaType="java.lang.String"/>
            <arg column="external_request_id" javaType="java.lang.String"/>
            <arg column="error_code" javaType="java.lang.String"/>
            <arg column="error_message" javaType="java.lang.String"/>
            <arg column="dispatched_at" javaType="java.time.Instant"/>
            <arg column="ack_at" javaType="java.time.Instant"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <select id="selectJobInstance" resultMap="JobInstanceResultMap">
        select id,
               tenant_id,
               job_code,
               biz_date,
               instance_status,
               run_attempt,
               trace_id,
               related_file_id,
               parent_instance_id,
               replay_session_id,
               started_at,
               finished_at,
               created_at,
               updated_at
        from batch.job_instance
        where tenant_id = #{tenantId}
          and id = #{jobInstanceId}
    </select>

    <select id="selectArchivedJobInstance" resultMap="JobInstanceResultMap">
        select id,
               tenant_id,
               job_code,
               biz_date,
               instance_status,
               run_attempt,
               trace_id,
               related_file_id,
               parent_instance_id,
               replay_session_id,
               started_at,
               finished_at,
               created_at,
               updated_at
        from archive.job_instance_archive
        where tenant_id = #{tenantId}
          and id = #{jobInstanceId}
    </select>

    <select id="selectPipelineInstances" resultMap="PipelineInstanceResultMap">
        select id,
               tenant_id,
               pipeline_definition_id,
               job_code,
               pipeline_type,
               file_id,
               related_job_instance_id,
               current_stage,
               last_success_stage,
               run_status,
               trace_id,
               started_at,
               finished_at,
               created_at,
               updated_at
        from batch.pipeline_instance
        where tenant_id = #{tenantId}
          and related_job_instance_id = #{jobInstanceId}
        order by id asc
    </select>

    <select id="selectArchivedPipelineInstances" resultMap="PipelineInstanceResultMap">
        select id,
               tenant_id,
               pipeline_definition_id,
               job_code,
               pipeline_type,
               file_id,
               related_job_instance_id,
               current_stage,
               last_success_stage,
               run_status,
               trace_id,
               started_at,
               finished_at,
               created_at,
               updated_at
        from archive.pipeline_instance_archive
        where tenant_id = #{tenantId}
          and related_job_instance_id = #{jobInstanceId}
        order by id asc
    </select>

    <select id="selectFileRecords" resultMap="FileRecordResultMap">
        select distinct fr.id,
               fr.tenant_id,
               fr.file_code,
               fr.biz_type,
               fr.file_category,
               fr.file_name,
               fr.file_format_type,
               fr.file_size_bytes,
               fr.checksum_type,
               fr.checksum_value,
               fr.storage_type,
               fr.storage_bucket,
               fr.storage_path,
               fr.file_status,
               fr.biz_date,
               fr.trace_id,
               fr.metadata_json::text as metadata_json,
               fr.created_at,
               fr.updated_at
        from batch.file_record fr
        where fr.tenant_id = #{tenantId}
          and (
              fr.id in (
                  select ji.related_file_id
                  from batch.job_instance ji
                  where ji.tenant_id = #{tenantId}
                    and ji.id = #{jobInstanceId}
                    and ji.related_file_id is not null
              )
              or fr.id in (
                  select pi.file_id
                  from batch.pipeline_instance pi
                  where pi.tenant_id = #{tenantId}
                    and pi.related_job_instance_id = #{jobInstanceId}
                    and pi.file_id is not null
              )
              <if test="payloadFileId != null">
              or fr.id = #{payloadFileId}
              </if>
          )
        order by fr.id asc
    </select>

    <select id="selectArchivedFileRecords" resultMap="FileRecordResultMap">
        select distinct fr.id,
               fr.tenant_id,
               fr.file_code,
               fr.biz_type,
               fr.file_category,
               fr.file_name,
               fr.file_format_type,
               fr.file_size_bytes,
               fr.checksum_type,
               fr.checksum_value,
               fr.storage_type,
               fr.storage_bucket,
               fr.storage_path,
               fr.file_status,
               fr.biz_date,
               fr.trace_id,
               fr.metadata_json::text as metadata_json,
               fr.created_at,
               fr.updated_at
        from archive.file_record_archive fr
        where fr.tenant_id = #{tenantId}
          and (
              fr.id in (
                  select ji.related_file_id
                  from archive.job_instance_archive ji
                  where ji.tenant_id = #{tenantId}
                    and ji.id = #{jobInstanceId}
                    and ji.related_file_id is not null
              )
              or fr.id in (
                  select pi.file_id
                  from archive.pipeline_instance_archive pi
                  where pi.tenant_id = #{tenantId}
                    and pi.related_job_instance_id = #{jobInstanceId}
                    and pi.file_id is not null
              )
              <if test="payloadFileId != null">
              or fr.id = #{payloadFileId}
              </if>
          )
        order by fr.id asc
    </select>

    <select id="selectDispatchRecords" resultMap="DispatchRecordResultMap">
        select distinct fdr.id,
               fdr.tenant_id,
               fdr.file_id,
               fdr.pipeline_instance_id,
               fdr.channel_code,
               fdr.dispatch_target,
               fdr.dispatch_status,
               fdr.dispatch_attempt,
               fdr.receipt_code,
               fdr.receipt_status,
               fdr.external_request_id,
               fdr.error_code,
               fdr.error_message,
               fdr.dispatched_at,
               fdr.ack_at,
               fdr.created_at,
               fdr.updated_at
        from batch.file_dispatch_record fdr
        left join batch.pipeline_instance pi
          on pi.tenant_id = fdr.tenant_id
         and pi.id = fdr.pipeline_instance_id
        where fdr.tenant_id = #{tenantId}
          and (
              pi.related_job_instance_id = #{jobInstanceId}
              <if test="fileIds != null and fileIds.size() > 0">
              or fdr.file_id in
              <foreach collection="fileIds" item="fileId" open="(" separator="," close=")">
                  #{fileId}
              </foreach>
              </if>
          )
        order by fdr.id desc
        limit 100
    </select>

    <select id="selectArchivedDispatchRecords" resultMap="DispatchRecordResultMap">
        select distinct fdr.id,
               fdr.tenant_id,
               fdr.file_id,
               fdr.pipeline_instance_id,
               fdr.channel_code,
               fdr.dispatch_target,
               fdr.dispatch_status,
               fdr.dispatch_attempt,
               fdr.receipt_code,
               fdr.receipt_status,
               fdr.external_request_id,
               fdr.error_code,
               fdr.error_message,
               fdr.dispatched_at,
               fdr.ack_at,
               fdr.created_at,
               fdr.updated_at
        from archive.file_dispatch_record_archive fdr
        left join archive.pipeline_instance_archive pi
          on pi.tenant_id = fdr.tenant_id
         and pi.id = fdr.pipeline_instance_id
        where fdr.tenant_id = #{tenantId}
          and (
              pi.related_job_instance_id = #{jobInstanceId}
              <if test="fileIds != null and fileIds.size() > 0">
              or fdr.file_id in
              <foreach collection="fileIds" item="fileId" open="(" separator="," close=")">
                  #{fileId}
              </foreach>
              </if>
          )
        order by fdr.id desc
        limit 100
    </select>
</mapper>
